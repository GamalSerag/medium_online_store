# Production
# DJANGO_SETTINGS_MODULE=config.settings.production
# SECRET_KEY=...
# DEBUG=0
# ALLOWED_HOSTS=al-serag.net,www.al-serag.net
# DATABASE_URL=postgres://alserag_user:STRONG_PASSWORD@127.0.0.1:5432/alserag_prod

# Staging (Dev)
# DJANGO_SETTINGS_MODULE=config.settings.staging
# SECRET_KEY=...
# DEBUG=0
# ALLOWED_HOSTS=dev.al-serag.net
# DATABASE_URL=postgres://alserag_user:STRONG_PASSWORD@127.0.0.1:5432/alserag_dev

# Visitor analytics country detection.
# Cloudflare/proxy country headers are used automatically when present;
# otherwise the app can look up public visitor IPs once per session.
# ANALYTICS_GEOIP_ENABLED=1
# ANALYTICS_GEOIP_ENDPOINT=https://ipapi.co/{ip}/json/
# ANALYTICS_GEOIP_TIMEOUT=0.8
